#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../test/support/botasaurus_fetch_configs'

unless BotasaurusFetchConfigs.botasaurus_env_configured?
  warn 'BOTASAURUS_SCRAPER_URL is required for botasaurus fetch tests.'
  exit 1
end

args = ['bundle', 'exec', 'rspec', '--tag', 'fetch']
BotasaurusFetchConfigs::CONFIGS.each do |config|
  args << '--example'
  args << config
end
args << 'test/configs_dynamic_spec.rb'

exec({ 'BUNDLE_GEMFILE' => 'tool/Gemfile' }, *args)

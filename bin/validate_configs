#!/usr/bin/env ruby
# frozen_string_literal: true

require 'bundler/setup'
require 'html2rss'

files = Dir['lib/html2rss/configs/**/*.yml']
failed = []

files.each do |file|
  result = Html2rss.validate(file)

  if result.success?
    puts "ok   #{file}"
  else
    puts "FAIL #{file}"
    result.issues.each { |issue| warn "       #{issue}" }
    failed << file
  end
rescue StandardError => error
  puts "FAIL #{file}"
  warn "       validation: #{error.class}: #{error.message}"
  failed << file
end

puts
if failed.empty?
  puts "#{files.size} configs validated successfully."
else
  warn "#{failed.size}/#{files.size} configs failed validation."
  exit 1
end
